<mxfile host="app.diagrams.net" agent="SPARKS-AI-Search" version="24.0.0">
  <diagram id="current-search" name="Current SPARKS Search">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Current SPARKS Search Process (As-Is)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Scheduled indexing pipeline (bottom) keeps OpenSearch populated; the user searches that index via the UI (top). Names, batch sizes and flags are from the actual Lambdas and PL/pgSQL. Each box is labeled with its AWS service + role." style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="120" y="58" width="1460" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend:  blue = user · orange = AWS Lambda (compute) · pink = messaging/scheduler · purple = OpenSearch · magenta = RDS/PostgreSQL · red = Secrets Manager · green = results" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="1460" height="20" as="geometry" />
        </mxCell>

        <!-- ================= USER SEARCH LANE ================= -->
        <mxCell id="laneUser" value="USER SEARCH PATH" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="user" value="SPARKS User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneUser">
          <mxGeometry x="60" y="55" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="SPARKS Search UI&#10;pills / filters / keyword box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="180" y="55" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="searchApi" value="Search API&#10;Amazon API Gateway + AWS Lambda&#10;builds query from pills/filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="520" y="55" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="osQuery" value="Amazon OpenSearch&#10;(sparks-stage domain)&#10;keyword + filter query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D5F7;strokeColor=#8C4FFF;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="880" y="55" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="results" value="Results List&#10;matching documents (by _id)&#10;rendered in SPARKS UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="1220" y="55" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_user_ui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ui_api" value="1. search request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="ui" target="searchApi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_api_os" value="2. query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="searchApi" target="osQuery"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_os_results" value="3. hits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="osQuery" target="results"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================= INDEXING PIPELINE LANE ================= -->
        <mxCell id="laneIndex" value="INDEXING PIPELINE (triggered by Amazon EventBridge every 5 min)" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1620" height="560" as="geometry" />
        </mxCell>

        <mxCell id="sched" value="Amazon EventBridge&#10;Scheduler&#10;(rate: 5 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="laneIndex">
          <mxGeometry x="40" y="70" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- RDS group -->
        <mxCell id="grpRds" value="Amazon RDS (PostgreSQL) — SPARKS database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf0fb;strokeColor=#C925D1;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="laneIndex">
          <mxGeometry x="250" y="40" width="470" height="470" as="geometry" />
        </mxCell>
        <mxCell id="builders" value="Domain JSON builders (PL/pgSQL)&#10;json_vtf_rec() · json_etf_rec()&#10;json_etfi_rec() · json_gi_rec()&#10;json_vtfi_rec()&#10;json_legacy_vehicle_rec()&#10;json_legacy_equipment_rec()&#10;json_legacy_investigation_rec()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;fontSize=11;" vertex="1" parent="laneIndex">
          <mxGeometry x="270" y="80" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pushidx" value="pushIndexToOpenSearchTable()&#10;calls pushJsonData(json, index)&#10;per domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;fontSize=11;" vertex="1" parent="laneIndex">
          <mxGeometry x="270" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="Table: sparks.open_search_json (outbox)&#10;osj_id · osj_table_index_name&#10;osj_json_data (document array)&#10;osj_read_yn · osj_processed_yn · osj_update_dt" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#C925D1;fontSize=11;" vertex="1" parent="laneIndex">
          <mxGeometry x="270" y="350" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dbhost" value="(hosted on Amazon RDS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#C925D1;" vertex="1" parent="laneIndex">
          <mxGeometry x="560" y="420" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- RDS-to-SQS Lambda -->
        <mxCell id="rl" value="AWS Lambda — RDS-to-SQS&#10;1. SELECT pushIndexToOpenSearchTable()&#10;2. SELECT * WHERE osj_read_yn=false&#10;   AND index IN (5 core + 3 legacy)&#10;   ORDER BY osj_create_dt DESC LIMIT 50&#10;3. batch 10 → SendMessageBatch&#10;4. on success: UPDATE osj_read_yn=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="laneIndex">
          <mxGeometry x="760" y="90" width="320" height="150" as="geometry" />
        </mxCell>

        <!-- Secrets -->
        <mxCell id="secrets" value="AWS Secrets Manager&#10;(sqsqueue URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#DD344C;fontSize=11;fontStyle=1;" vertex="1" parent="laneIndex">
          <mxGeometry x="810" y="300" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- FIFO -->
        <mxCell id="fifo" value="Amazon SQS — SearchQueue.fifo&#10;MessageGroupId = index name&#10;DeduplicationId = osj_id&#10;Attributes: DatabaseId, IndexName&#10;(IDs only, not full payload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="laneIndex">
          <mxGeometry x="760" y="400" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- SQS-to-OpenSearch Lambda -->
        <mxCell id="ol" value="AWS Lambda — SQS-to-OpenSearch&#10;1. checkIndex()/createIndex() (never deletes)&#10;2. SELECT osj_json_data WHERE osj_id=DatabaseId&#10;3. chunk 1000, _stableId() → _id&#10;   legacy → 'legacy_equipment:&lt;id&gt;' ...&#10;   non-legacy → uniqueId ?? id&#10;4. populateIndex() bulk&#10;5. UPDATE osj_processed_yn=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="laneIndex">
          <mxGeometry x="1140" y="90" width="330" height="160" as="geometry" />
        </mxCell>

        <!-- OpenSearch target -->
        <mxCell id="osIndex" value="Amazon OpenSearch (sparks-stage)&#10;Indexes:&#10;general_inv · equip_test_file&#10;equip_test_failure_inv&#10;vehicle_test_failure_inv&#10;vehicle_test_file&#10;legacy_vehicle / equipment / investigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D5F7;strokeColor=#8C4FFF;fontSize=11;fontStyle=1;" vertex="1" parent="laneIndex">
          <mxGeometry x="1180" y="320" width="290" height="160" as="geometry" />
        </mxCell>

        <!-- indexing edges -->
        <mxCell id="e_sched_rl" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="sched" target="rl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_builders_push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#C925D1;" edge="1" parent="1" source="builders" target="pushidx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_push_outbox" value="insert / update JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#C925D1;" edge="1" parent="1" source="pushidx" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rl_push" value="A. run pushIndexToOpenSearchTable()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="rl" target="pushidx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rl_outbox" value="B. SELECT unread rows / set read=Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="rl" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rl_secrets" value="get queue URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#DD344C;" edge="1" parent="1" source="rl" target="secrets"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rl_fifo" value="C. send osj_id + index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="rl" target="fifo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fifo_ol" value="D. trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="fifo" target="ol"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ol_outbox" value="E. re-fetch payload by osj_id / set processed=Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="ol" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ol_os" value="F. bulk index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="ol" target="osIndex"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_osindex_osquery" value="same domain the UI searches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#8C4FFF;exitX=0.5;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="osIndex" target="osQuery"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
