<mxfile host="app.diagrams.net" agent="SPARKS-AI-Search" version="24.0.0">
  <diagram id="option1-rag" name="Option 1 - RAG (Generative AI)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Option 1 — Generative AI / RAG Search (&quot;Ask SPARKS&quot; chat box)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Existing OpenSearch pipeline is UNCHANGED (grey lane). The new AI path reads the same outbox read-only and answers via Claude with citations. Each box is labeled with its AWS service + role." style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="150" y="58" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend:  pink = messaging/API · orange = AWS Lambda (compute) · teal = Amazon Bedrock (AI) · purple = OpenSearch · green = S3 storage · blue = user · grey = unchanged" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="150" y="80" width="1400" height="20" as="geometry" />
        </mxCell>

        <!-- ================= USER LANE ================= -->
        <mxCell id="laneUser" value="1 · USER" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="user" value="SPARKS User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneUser">
          <mxGeometry x="60" y="45" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chatbox" value="&quot;Ask SPARKS&quot; Chat Box&#10;(natural-language question)&#10;e.g. &quot;child seats that failed labeling&#10;under FMVSS 213 since 2020&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="180" y="40" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="existingUI" value="Existing SPARKS Search UI&#10;(pills / filters / keyword)&#10;— remains available, unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;dashed=1;fontColor=#666666;" vertex="1" parent="laneUser">
          <mxGeometry x="520" y="45" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="answerCard" value="Answer Card&#10;grounded summary + citations&#10;(each cites uniqueId, e.g.&#10;legacy_equipment:12251)&#10;+ follow-up suggestions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="1180" y="35" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- ================= APPLICATION / API LANE ================= -->
        <mxCell id="laneApp" value="2 · APPLICATION / API" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="Amazon API Gateway&#10;/ask REST endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="laneApp">
          <mxGeometry x="200" y="45" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="orchLambda" value="AWS Lambda&#10;Ask-SPARKS Orchestrator&#10;(RAG query handler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="laneApp">
          <mxGeometry x="520" y="45" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="router" value="Intent Router&#10;exact/filter → existing OpenSearch&#10;semantic/NL → RAG path" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="laneApp">
          <mxGeometry x="880" y="40" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ================= AI RETRIEVAL + GENERATION LANE ================= -->
        <mxCell id="laneAI" value="3 · AI RETRIEVAL &amp; GENERATION (Amazon Bedrock)" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#e1f5e1;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="kb" value="Amazon Bedrock&#10;Knowledge Base&#10;chunk + embed + retrieve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#009E8E;fontSize=12;fontStyle=1;" vertex="1" parent="laneAI">
          <mxGeometry x="200" y="55" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="vector" value="Vector Store&#10;Amazon OpenSearch&#10;vector index (k-NN + filters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D5F7;strokeColor=#8C4FFF;fontSize=12;fontStyle=1;" vertex="1" parent="laneAI">
          <mxGeometry x="540" y="55" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="claude" value="Claude on Amazon Bedrock&#10;(LLM) grounded answer + citations&#10;reuses uniqueId as source id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#009E8E;fontSize=12;fontStyle=1;" vertex="1" parent="laneAI">
          <mxGeometry x="880" y="55" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="guardrails" value="Amazon Bedrock&#10;Guardrails&#10;(safety / grounding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#009E8E;fontSize=12;fontStyle=1;" vertex="1" parent="laneAI">
          <mxGeometry x="1200" y="55" width="200" height="85" as="geometry" />
        </mxCell>

        <!-- ================= AI DATA PREP LANE ================= -->
        <mxCell id="lanePrep" value="4 · AI DATA PREPARATION (new, read-only)" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="prepSched" value="Amazon EventBridge&#10;Scheduler&#10;(search-content refresh cadence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="lanePrep">
          <mxGeometry x="120" y="50" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="extractor" value="AWS Lambda (or Glue)&#10;AI Extractor / Enricher&#10;reads osj_json_data (read-only);&#10;optional: fill failure_type /&#10;prob_summary / sme_recc, add&#10;comments &amp; status history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="lanePrep">
          <mxGeometry x="440" y="35" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Amazon S3&#10;Curated AI Search Content&#10;partitioned by domain;&#10;one object per uniqueId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#7AA116;fontSize=12;fontStyle=1;" vertex="1" parent="lanePrep">
          <mxGeometry x="820" y="45" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ================= EXISTING PIPELINE LANE (UNCHANGED) ================= -->
        <mxCell id="laneExisting" value="5 · EXISTING SPARKS PIPELINE — UNCHANGED" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#f0f0f0;strokeColor=#999999;fontStyle=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="Amazon RDS (PostgreSQL)&#10;json_*_rec() builders +&#10;pushIndexToOpenSearchTable()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneExisting">
          <mxGeometry x="40" y="55" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="sparks.open_search_json&#10;(outbox / staging table)&#10;osj_id · osj_json_data&#10;osj_read_yn · osj_processed_yn" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneExisting">
          <mxGeometry x="290" y="48" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rl" value="AWS Lambda&#10;RDS-to-SQS&#10;(LIMIT 50, batch 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneExisting">
          <mxGeometry x="540" y="55" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fifo" value="Amazon SQS&#10;SearchQueue.fifo&#10;(IDs only: osj_id + index)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneExisting">
          <mxGeometry x="790" y="55" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ol" value="AWS Lambda&#10;SQS-to-OpenSearch&#10;chunk 1000, _stableId → _id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneExisting">
          <mxGeometry x="1040" y="55" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="os" value="Amazon OpenSearch&#10;(sparks-stage)&#10;keyword / filter indexes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneExisting">
          <mxGeometry x="1300" y="55" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- ================= EDGES ================= -->
        <mxCell id="e_user_chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="user" target="chatbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_chat_api" value="1. question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="chatbox" target="apigw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_api_orch" value="2. invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="apigw" target="orchLambda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_orch_router" value="3. classify intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="orchLambda" target="router"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_router_kb" value="4a. semantic / NL → retrieve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="router" target="kb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="640" /><mxPoint x="350" y="640" /></Array></mxGeometry></mxCell>
        <mxCell id="e_router_os" value="4b. exact / filter (existing)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="router" target="os"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_kb_vec" value="5. embed query / k-NN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="kb" target="vector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vec_claude" value="6. top-k chunks (+uniqueId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="vector" target="claude"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_claude_guard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="claude" target="guardrails"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_claude_answer" value="7. grounded answer + citations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="claude" target="answerCard"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_sched_extract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="prepSched" target="extractor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_extract_outbox" value="read-only tap (no outbox change)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="extractor" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_extract_s3" value="write curated JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="extractor" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s3_kb" value="ingest / sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="s3" target="kb"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_rds_outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;" edge="1" parent="1" source="rds" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_outbox_rl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;" edge="1" parent="1" source="outbox" target="rl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rl_fifo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;" edge="1" parent="1" source="rl" target="fifo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fifo_ol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;" edge="1" parent="1" source="fifo" target="ol"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ol_outbox" value="re-fetch by osj_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="ol" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ol_os" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;" edge="1" parent="1" source="ol" target="os"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
