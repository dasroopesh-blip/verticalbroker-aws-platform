        <mxCell id="doc" value="SPARKS Document  (inside osj_json_data[])" style="shape=table;html=1;startSize=28;container=1;collapsible=0;fillColor=#eeeeee;strokeColor=#999999;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="360" height="150" as="geometry" />
