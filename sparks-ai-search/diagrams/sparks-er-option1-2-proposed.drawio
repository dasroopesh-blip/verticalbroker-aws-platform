        <mxCell id="grpExisting" value="EXISTING SPARKS (unchanged — source of truth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
