        <!-- option2 session -> toolcall -> doc -->
        <mxCell id="r_sess_tool" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;rounded=0;strokeColor=#82b366;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="session" target="toolcall"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r_tool_doc" value="returns uniqueId[]" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERzeroToMany;rounded=0;strokeColor=#82b366;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.6;" edge="1" parent="1" source="toolcall" target="doc"><mxGeometry relative="1" as="geometry" /></mxCell>
