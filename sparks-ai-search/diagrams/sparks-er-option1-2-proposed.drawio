        <mxCell id="title" value="Proposed ER / Data Model — AI Search (Option 1 &amp; Option 2)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="GREY = existing SPARKS entities (unchanged). GREEN = NEW entities introduced by the AI solution. Every new entity ties back to the existing documents through the uniqueId key. Option 2 adds the AgentToolCall / session entities only (shown dashed)." style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="1300" height="36" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend:  grey = existing (unchanged)  ·  green = NEW (Option 1 — RAG)  ·  dashed green = NEW (Option 2 — Agentic only)  ·  key link = uniqueId" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="200" y="96" width="1300" height="20" as="geometry" />
        </mxCell>

