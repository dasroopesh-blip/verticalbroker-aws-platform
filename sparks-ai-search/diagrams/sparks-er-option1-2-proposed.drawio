        <mxCell id="corpus" value="CuratedSearchContent  (Amazon S3)  — NEW" style="shape=table;html=1;startSize=28;container=1;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
