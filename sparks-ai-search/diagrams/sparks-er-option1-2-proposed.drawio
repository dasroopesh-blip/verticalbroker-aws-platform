        <!-- note -->
        <mxCell id="note" value="KEY POINT for review: no existing table is altered. The AI solution adds a read-only derived layer (search content → chunk → embedding) keyed on the SAME uniqueId, so every AI answer/citation resolves back to a real SPARKS document and its OpenSearch _id. Option 2 adds only observability/orchestration entities (AgentSession, AgentToolCall) — still no change to source data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="500" height="140" as="geometry" />
