        <mxCell id="r_doc_corpus" value="1 : 1  via uniqueId  (read-only reuse)" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;rounded=0;strokeColor=#2E7D32;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="doc" target="corpus"><mxGeometry relative="1" as="geometry" /></mxCell>

