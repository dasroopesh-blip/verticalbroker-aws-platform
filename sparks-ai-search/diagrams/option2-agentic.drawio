        <mxCell id="e_agent_t3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="agent" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agent_t4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="agent" target="t4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agent_guard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="agent" target="guardrails"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_t1_os" value="5a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="t1" target="os"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_t2_vec" value="5b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t2" target="vector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_t3_rds" value="5c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t3" target="rdsviews"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_t4_ref" value="5d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t4" target="refdocs"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_agent_answer" value="6. grounded answer + sources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="agent" target="answerCard"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="455" /><mxPoint x="1330" y="455" /></Array></mxGeometry></mxCell>

        <mxCell id="e_s3_kb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="kb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_kb_vec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="kb" target="vector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_prep_outbox" value="read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="prep" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_prep_s3" value="write curated JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="prep" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>

