<mxfile host="app.diagrams.net" agent="SPARKS-AI-Search" version="24.0.0">
  <diagram id="option2-agentic" name="Option 2 - Agentic Hybrid">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Option 2 — Agentic Hybrid Search (&quot;Ask SPARKS&quot; chat box)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Same chat box as Option 1. An agent decides which approved tools to call, reasons across steps, then generates a grounded answer. Each box is labeled with its AWS service + role." style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="150" y="58" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend:  pink = messaging/API · orange = AWS Lambda (compute) · teal = Amazon Bedrock (AI) · purple = OpenSearch · green = S3 storage · magenta = RDS · blue = user · grey = unchanged" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="150" y="80" width="1400" height="20" as="geometry" />
        </mxCell>

        <!-- ================= USER LANE ================= -->
        <mxCell id="laneUser" value="1 · USER" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1620" height="160" as="geometry" />
        </mxCell>
        <mxCell id="user" value="SPARKS User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneUser">
          <mxGeometry x="60" y="50" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chatbox" value="&quot;Ask SPARKS&quot; Chat Box (Agentic)&#10;multi-step question, e.g.&#10;&quot;Find Ford investigations since 2022&#10;involving camera/visibility failures,&#10;compare them, and tell me which&#10;resulted in recalls.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="180" y="35" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="answerCard" value="Answer with Sources&#10;synthesis across records + summary&#10;related uniqueIds · key insights&#10;follow-up suggestions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="laneUser">
          <mxGeometry x="1180" y="45" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- ================= APPLICATION / API LANE ================= -->
        <mxCell id="laneApp" value="2 · APPLICATION / API" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="Amazon API Gateway&#10;/ask REST endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="laneApp">
          <mxGeometry x="300" y="35" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="appLambda" value="AWS Lambda&#10;Ask-SPARKS API (invokes agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="laneApp">
          <mxGeometry x="640" y="35" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ================= AGENT ORCHESTRATION LANE ================= -->
        <mxCell id="laneAgent" value="3 · AGENT ORCHESTRATION (Amazon Bedrock Agent / AgentCore)" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#e1f5e1;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1620" height="250" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="Amazon Bedrock Agent (Claude)&#10;plan → select tools → call →&#10;observe → combine → ground &amp; generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#009E8E;fontSize=12;fontStyle=1;" vertex="1" parent="laneAgent">
          <mxGeometry x="80" y="90" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="toolbox" value="APPROVED TOOL SET (no raw SQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#82b366;fontStyle=1;verticalAlign=top;fontSize=12;dashed=1;" vertex="1" parent="laneAgent">
          <mxGeometry x="380" y="40" width="770" height="195" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="Tool: openSearchSearch(query, filters)&#10;→ EXISTING OpenSearch index (exact/filter)&#10;(_id == uniqueId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="laneAgent">
          <mxGeometry x="400" y="80" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Tool: semanticSearch(query, filters, top_k)&#10;→ vector retrieval (shared AI search content)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="laneAgent">
          <mxGeometry x="400" y="155" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Tool: getInvestigation / getVehicle /&#10;getEquipment(uniqueId)&#10;→ read-only record lookups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="laneAgent">
          <mxGeometry x="780" y="80" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="Tool (optional): reference docs /&#10;procedures / approved APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="laneAgent">
          <mxGeometry x="780" y="155" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="guardrails" value="Amazon Bedrock&#10;Guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#009E8E;fontSize=12;fontStyle=1;" vertex="1" parent="laneAgent">
          <mxGeometry x="1200" y="100" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- ================= DATA SOURCES LANE ================= -->
        <mxCell id="laneSrc" value="4 · DATA SOURCES &amp; RESOURCES" style="swimlane;horizontal=0;html=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1620" height="470" as="geometry" />
