        <mxCell id="grpAI" value="AI search content (same as Option 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e6;strokeColor=#d79b00;dashed=1;verticalAlign=top;fontSize=12;fontStyle=2;" vertex="1" parent="laneSrc">
