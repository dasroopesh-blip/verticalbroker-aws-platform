          <mxGeometry x="385" y="80" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="kb" value="Amazon Bedrock&#10;Knowledge Base&#10;(chunk + embed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#009E8E;fontSize=11;fontStyle=1;" vertex="1" parent="laneSrc">
          <mxGeometry x="585" y="80" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="vector" value="Amazon OpenSearch&#10;vector index&#10;(semantic store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D5F7;strokeColor=#8C4FFF;fontSize=11;fontStyle=1;" vertex="1" parent="laneSrc">
          <mxGeometry x="785" y="80" width="170" height="75" as="geometry" />
        </mxCell>

        <mxCell id="os" value="EXISTING Amazon OpenSearch&#10;(sparks-stage)&#10;unchanged pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneSrc">
          <mxGeometry x="100" y="80" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="rdsviews" value="Amazon RDS (PostgreSQL)&#10;read-only views&#10;(record lookups)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9F5;strokeColor=#C925D1;fontSize=11;fontStyle=1;" vertex="1" parent="laneSrc">
          <mxGeometry x="1040" y="80" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="refdocs" value="Amazon S3&#10;reference docs /&#10;procedures (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#7AA116;fontSize=11;fontStyle=1;" vertex="1" parent="laneSrc">
          <mxGeometry x="1290" y="80" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="prep" value="AWS Lambda — AI Extractor / Enricher (read-only)&#10;reads osj_json_data from outbox, writes curated JSON to S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="laneSrc">
          <mxGeometry x="385" y="270" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="sparks.open_search_json&#10;(existing outbox, unchanged)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#555555;" vertex="1" parent="laneSrc">
          <mxGeometry x="820" y="265" width="160" height="95" as="geometry" />
        </mxCell>

        <!-- ================= EDGES ================= -->
        <mxCell id="e_user_chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="user" target="chatbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_chat_api" value="1. question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="chatbox" target="apigw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_api_app" value="2. invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="apigw" target="appLambda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_app_agent" value="3. invoke agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="appLambda" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_agent_t1" value="4. call tools (loop)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="agent" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
