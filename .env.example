# =============================================================================
# VerticalBroker Platform - Environment Variables
# Copy to .env and update values for your environment.
# NEVER commit .env to git (it's in .gitignore)
# =============================================================================

# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=verticalbroker-dev
# AWS_ACCESS_KEY_ID=           # Only for local dev (prefer profiles)
# AWS_SECRET_ACCESS_KEY=       # Only for local dev (prefer profiles)

# Environment
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# Lambda Powertools
POWERTOOLS_SERVICE_NAME=verticalbroker
POWERTOOLS_METRICS_NAMESPACE=VerticalBroker
POWERTOOLS_LOG_LEVEL=DEBUG

# S3 Buckets (set per environment)
BRONZE_BUCKET=vb-bronze-dev
SILVER_BUCKET=vb-silver-dev
GOLD_BUCKET=vb-gold-dev
REGULATORY_BUCKET=vb-regulatory-dev

# DynamoDB Tables
IDEMPOTENCY_TABLE=IdempotencyStore
CIRCUIT_BREAKER_TABLE=CircuitBreakerState
ORDERS_TABLE=Orders
OUTBOX_TABLE=OrderOutbox
PORTFOLIO_TABLE=Portfolio

# Streaming
EVENT_BUS_NAME=verticalbroker-platform-dev
DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/market-data-dlq

# ML/SageMaker
SAGEMAKER_ENDPOINT=advisory-model-endpoint-dev
MODEL_ENDPOINT_NAME=advisory-model-endpoint-dev

# Glue
GLUE_DATABASE=verticalbroker_dev

# Local Development (LocalStack)
# Uncomment for local dev with docker-compose
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=testing
# AWS_SECRET_ACCESS_KEY=testing

# PostgreSQL (local dev only)
PGHOST=localhost
PGPORT=5432
PGDATABASE=verticalbroker
PGUSER=vb_admin
# PGPASSWORD=local_dev_only   # Set in shell, don't store here
