<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="ML SageMaker RL Advisory Pipeline" id="ml-pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="SageMaker RL Advisory Pipeline (Training → Deployment → Inference)" style="text;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="train_title" value="TRAINING PIPELINE (Weekly)" style="text;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1140" height="22" as="geometry" /></mxCell>
        <mxCell id="gold" value="S3 Gold Layer&#10;Historical Client&#10;Outcomes" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="feat" value="Feature Engineering&#10;(ml.m5.xlarge)&#10;Extract profiles +&#10;market features" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="90" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="train" value="RL Training (PPO)&#10;(ml.p3.2xlarge GPU)&#10;lr=0.0003 | γ=0.99&#10;10K episodes | batch=256" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="85" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="eval" value="Evaluation&#10;Performance metrics&#10;Bias detection&#10;Fairness (5% threshold)&#10;SHAP explainability" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="80" width="160" height="90" as="geometry" /></mxCell>
        <mxCell id="reg" value="Model Registry&#10;Version + metadata&#10;PendingManualApproval" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="160" height="70" as="geometry" /></mxCell>
        <mxCell id="ef1" edge="1" source="gold" target="feat" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef2" edge="1" source="feat" target="train" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef3" edge="1" source="train" target="eval" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef4" edge="1" source="eval" target="reg" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gov_title" value="GOVERNANCE GATE" style="text;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="1140" height="22" as="geometry" /></mxCell>
        <mxCell id="bias" value="check_bias()&#10;Age | Income&#10;Filing Status groups" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="fair" value="validate_fairness()&#10;Max 5% deviation&#10;across all groups" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="shap" value="generate_explainability()&#10;SHAP feature importance&#10;Top 10 features" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="240" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="approve" value="approve_for_deployment()&#10;APPROVED | REJECTED&#10;PENDING_REVIEW" style="rhombus;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="230" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="ef5" edge="1" source="bias" target="fair" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
