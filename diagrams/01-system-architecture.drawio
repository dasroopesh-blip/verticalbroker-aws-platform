<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="System Architecture - Corrected Flows" id="system-arch-v2">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="VerticalBroker Platform — Corrected Data Flow Architecture" style="text;fontSize=18;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="600" height="30" as="geometry" /></mxCell>

        <!-- ============ LANE 1: TRANSACTIONAL TRADING (Client-facing) ============ -->
        <mxCell id="lane1" value="LANE 1: TRANSACTIONAL TRADING (Client-facing via API Gateway)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1560" height="250" as="geometry" />
        </mxCell>

        <!-- Trader Interface -->
        <mxCell id="trader" value="Trader Interface&#10;(Web + Mobile)&#10;200M monthly users" style="shape=actor;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lane1">
          <mxGeometry x="30" y="40" width="100" height="80" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigw" value="API Gateway&#10;REST + WebSocket&#10;Cognito JWT Auth&#10;10K req/sec" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="200" y="50" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Client-facing Lambdas (ONLY these are behind API Gateway) -->
        <mxCell id="lambda_om" value="λ Order Manager&#10;(1000 concurrency)&#10;POST /v1/orders" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane1">
          <mxGeometry x="430" y="30" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="lambda_ws" value="λ Wallet Service&#10;GET /v1/portfolio&#10;+ SQS FIFO consumer" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane1">
          <mxGeometry x="430" y="100" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="lambda_aa" value="λ Advisory Agent&#10;(500 concurrency)&#10;POST /v1/advisory" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane1">
          <mxGeometry x="430" y="170" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- NOTE: No Market Data Lambda here! -->
        <mxCell id="note1" value="NOTE: Market Data Service Lambda&#10;is NOT behind API Gateway.&#10;It is triggered by Kinesis (Lane 2)." style="text;whiteSpace=wrap;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="lane1">
          <mxGeometry x="620" y="170" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Databases -->
        <mxCell id="aurora" value="Aurora PostgreSQL&#10;Multi-AZ Serverless v2&#10;ACID LEDGER TRUTH" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="880" y="30" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dynamodb" value="DynamoDB&#10;Idempotency | Orders&#10;Outbox | Portfolio" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane1">
          <mxGeometry x="880" y="130" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sagemaker_ep" value="SageMaker Endpoint&#10;A/B (90/10)&#10;&lt; 500ms" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="1100" y="170" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Cognito&#10;JWT + MFA" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="200" y="150" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- Lane 1 Arrows -->
        <mxCell id="e1" edge="1" source="trader" target="apigw" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" source="apigw" target="lambda_om" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" source="apigw" target="lambda_ws" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" source="apigw" target="lambda_aa" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" source="lambda_om" target="aurora" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" source="lambda_om" target="dynamodb" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" source="lambda_ws" target="dynamodb" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" source="lambda_aa" target="sagemaker_ep" parent="lane1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ LANE 2: MARKET DATA + EVENT + LAKEHOUSE ============ -->
        <mxCell id="lane2" value="LANE 2: MARKET DATA INGESTION + EVENT + LAKEHOUSE (NOT client-facing)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="1560" height="350" as="geometry" />
        </mxCell>

        <!-- External Market Data Sources -->
        <mxCell id="bloomberg" value="Bloomberg&#10;B-Pipe&#10;(Direct Connect)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="40" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reuters" value="Thomson Reuters&#10;RTDS&#10;(Direct Connect)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="120" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- EC2 Feed Handler -->
        <mxCell id="ec2_feed" value="EC2 Feed Handler&#10;(persistent TCP)&#10;Kinesis Producer&#10;ASG: 2-4 instances" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="210" y="60" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Kinesis -->
        <mxCell id="kinesis" value="Kinesis Data Streams&#10;16 shards | 12K/sec burst&#10;ON_DEMAND | 7-day retention" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="410" y="60" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Market Data Lambda (Kinesis-triggered, NOT API Gateway) -->
        <mxCell id="lambda_md" value="λ Market Data Processor&#10;(2000 concurrency)&#10;TRIGGERED BY KINESIS&#10;NOT by API Gateway" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="650" y="50" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- EventBridge -->
        <mxCell id="eventbridge" value="EventBridge&#10;verticalbroker-platform&#10;5 event types&#10;Schema Registry" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="410" y="170" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- SQS + Step Functions -->
        <mxCell id="sqs_fifo" value="SQS FIFO&#10;trade-processing&#10;(Exactly-once)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane2">
          <mxGeometry x="640" y="180" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="stepfn" value="Step Functions&#10;ETL Orchestrator&#10;(7 states, 3x retry)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane2">
          <mxGeometry x="800" y="180" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- Data Lake -->
        <mxCell id="s3_bronze" value="S3 BRONZE&#10;Raw/Immutable&#10;Parquet | Object Lock&#10;Hive Partitioned" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="900" y="40" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="glue" value="Glue PySpark&#10;G.2X | 100 DPUs&#10;Auto-scaling | Spot" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane2">
          <mxGeometry x="1080" y="160" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3_silver" value="S3 SILVER&#10;Validated Parquet" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane2">
          <mxGeometry x="1100" y="50" width="110" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3_gold" value="S3 GOLD&#10;Aggregated" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane2">
          <mxGeometry x="1260" y="50" width="110" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dms" value="DMS CDC&#10;Aurora → S3&#10;&lt; 30s" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane2">
          <mxGeometry x="1260" y="160" width="100" height="55" as="geometry" />
        </mxCell>

        <!-- Lane 2 Arrows -->
        <mxCell id="f1" edge="1" source="bloomberg" target="ec2_feed" parent="lane2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" edge="1" source="reuters" target="ec2_feed" parent="lane2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" edge="1" source="ec2_feed" target="kinesis" parent="lane2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" edge="1" source="kinesis" target="lambda_md" parent="lane2" value="triggers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" edge="1" source="lambda_md" target="s3_bronze" parent="lane2" value="writes Parquet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" edge="1" source="lambda_md" target="eventbridge" parent="lane2" value="data.ingested"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" edge="1" source="eventbridge" target="sqs_fifo" parent="lane2" value="trade.executed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" edge="1" source="eventbridge" target="stepfn" parent="lane2" value="data.ingested"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" edge="1" source="stepfn" target="glue" parent="lane2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" edge="1" source="s3_bronze" target="s3_silver" parent="lane2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" edge="1" source="s3_silver" target="s3_gold" parent="lane2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ LANE 3: ML + CONSUMPTION ============ -->
        <mxCell id="lane3" value="LANE 3: ML + CONSUMPTION (Analytics services fed from Gold Layer)" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="690" width="1560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="opensearch" value="OpenSearch&#10;Search + Dashboards&#10;FINRA 7yr ISM" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="50" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="neptune" value="Neptune&#10;Graph/Fraud&#10;Gremlin" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="220" y="50" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="athena" value="Athena SQL&#10;3 Workgroups&#10;Ad-hoc queries" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="390" y="60" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sm_train" value="SageMaker&#10;RL Training (PPO)&#10;Model Registry" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="570" y="50" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reg_store" value="Regulatory Store&#10;S3 COMPLIANCE Lock&#10;7yr FINRA 4511" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="760" y="50" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- ============ CROSS-CUTTING ============ -->
        <mxCell id="crosscut" value="CROSS-CUTTING: KMS (4 CMKs) | IAM Least-Privilege | GuardDuty | SecurityHub | CloudTrail | Organizations (100+ accts) | Transit Gateway | CloudWatch (9 alarms + 3 composite) | X-Ray | SSM Runbooks | CRR DR (us-west-2)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="910" width="1560" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
