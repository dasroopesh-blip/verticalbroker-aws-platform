<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="ETL Pipeline Flow - Bronze to Silver to Gold" id="etl-flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ETL Pipeline: Bronze → Silver → Gold (Glue PySpark)" style="text;fontSize=18;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="500" height="30" as="geometry" /></mxCell>
        <mxCell id="b2s_title" value="BRONZE → SILVER (60 min SLA)" style="text;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1340" height="25" as="geometry" /></mxCell>
        <mxCell id="src" value="S3 Bronze&#10;Raw JSON&#10;Hive Partitioned&#10;source/year/month/day/hour" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="150" height="90" as="geometry" /></mxCell>
        <mxCell id="extract" value="Extract&#10;Glue Catalog&#10;push_down_predicate" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="validate" value="Validate Schema&#10;Catalog schema check&#10;Non-null required fields" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="dedup" value="Deduplicate&#10;instrument_id +&#10;timestamp + source&#10;(keep latest)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="dq" value="Data Quality&#10;Null thresholds (5%)&#10;Range validation&#10;Freshness (24h)&#10;ABORT if &gt;30% fail" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="silver_out" value="S3 Silver&#10;Parquet/Snappy&#10;Partitioned by&#10;instrument_type + trade_date" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="90" width="160" height="90" as="geometry" /></mxCell>
        <mxCell id="lineage" value="Lineage&#10;Record&#10;(S3 JSON)" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="100" height="50" as="geometry" /></mxCell>
        <mxCell id="err" value="Error Partition&#10;_errors/" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="200" width="120" height="60" as="geometry" /></mxCell>
        <mxCell id="ea" edge="1" source="src" target="extract" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" edge="1" source="extract" target="validate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" edge="1" source="validate" target="dedup" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" edge="1" source="dedup" target="dq" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" edge="1" source="dq" target="silver_out" parent="1" value="Pass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef" edge="1" source="silver_out" target="lineage" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eg" edge="1" source="dq" target="err" parent="1" value="Fail" style="strokeColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2g_title" value="SILVER → GOLD (30 min SLA)" style="text;fontSize=14;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1340" height="25" as="geometry" /></mxCell>
        <mxCell id="silver_in" value="S3 Silver&#10;Validated Parquet" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="incr" value="Incremental&#10;Extract&#10;CDC markers&#10;(avoid 10PB rescan)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="350" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="g1" value="daily_trade_summaries&#10;OHLCV + VWAP&#10;trade_count" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="340" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="g2" value="client_portfolio_snapshots&#10;Positions + P&amp;L&#10;Avg cost basis" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="g3" value="instrument_performance&#10;Returns (1d-252d)&#10;Volatility | Sharpe | RSI" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="g4" value="risk_exposure_aggregates&#10;VaR | CVaR | Beta&#10;By client/sector/geo" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="ri" value="Referential&#10;Integrity Check&#10;(FK validation)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="370" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="gold_out" value="S3 GOLD&#10;Parquet&#10;Partition by date&#10;Athena-optimized" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="350" width="140" height="90" as="geometry" /></mxCell>
        <mxCell id="fa" edge="1" source="silver_in" target="incr" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fb" edge="1" source="incr" target="g1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fc" edge="1" source="incr" target="g2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fd" edge="1" source="g1" target="ri" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe" edge="1" source="g4" target="ri" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ff" edge="1" source="ri" target="gold_out" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="config" value="Config: G.2X workers | 10-100 DPUs | Auto-scaling | Spot + On-Demand fallback | Job Bookmarks enabled | KMS encryption" style="text;whiteSpace=wrap;fontSize=11;fontStyle=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="700" height="25" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
