        <mxCell id="title" value="Step Functions: ETL Pipeline Orchestrator" style="text;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="400" height="30" as="geometry" /></mxCell>
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="50" width="30" height="30" as="geometry" /></mxCell>
