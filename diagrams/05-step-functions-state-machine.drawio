  <diagram name="Step Functions - ETL Pipeline Orchestrator" id="sfn">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900">
      <root>
