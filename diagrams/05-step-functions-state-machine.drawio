        <mxCell id="s3" value="TriggerBronzeToSilver&#10;(Glue startJobRun.sync)&#10;Retry: 3x / 60s / 2.0 backoff" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="320" width="210" height="60" as="geometry" /></mxCell>
        <mxCell id="s4" value="TriggerSilverToGold&#10;(Glue startJobRun.sync)&#10;Retry: 3x / 60s / 2.0 backoff" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="210" height="60" as="geometry" /></mxCell>
        <mxCell id="s5" value="TriggerIndexing&#10;(Parallel)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="150" height="50" as="geometry" /></mxCell>
