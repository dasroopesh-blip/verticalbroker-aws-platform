# ---------------------------------------------------------------------------
# filings-assistant configuration (copy to .env for local dev)
# ---------------------------------------------------------------------------
# Every value has a sensible default in code; this file documents the knobs.

# Deployment / run mode
# local  = use local OpenSearch + Postgres from docker-compose, mock Bedrock/SEC
#          if credentials/network are unavailable (great for $0 dev)
# aws    = use real AWS services (Bedrock, OpenSearch Service, RDS, SQS)
FA_RUN_MODE=local

# --- AWS / Bedrock ---------------------------------------------------------
AWS_REGION=us-east-1
# Model IDs are configurable so you can bump versions without code changes.
# Enable model access in the Bedrock console for your region first.
FA_BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
FA_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
FA_EMBEDDING_DIMENSIONS=1024
# If true, skip real Bedrock calls and use a deterministic local fake
# (hash-based embeddings + templated answers). Lets the pipeline run offline.
FA_USE_MOCK_BEDROCK=true

# --- OpenSearch ------------------------------------------------------------
FA_OPENSEARCH_HOST=localhost
FA_OPENSEARCH_PORT=9200
FA_OPENSEARCH_USE_SSL=false
FA_OPENSEARCH_INDEX=sec-filings
FA_OPENSEARCH_USER=admin
FA_OPENSEARCH_PASSWORD=admin

# --- Postgres (source of truth) -------------------------------------------
FA_PG_HOST=localhost
FA_PG_PORT=5432
FA_PG_DB=filings
FA_PG_USER=fa_admin
FA_PG_PASSWORD=local_dev_only

# --- Queue -----------------------------------------------------------------
# In aws mode this is an SQS queue URL; in local mode an in-process queue is used.
FA_QUEUE_URL=

# --- SEC EDGAR -------------------------------------------------------------
# The SEC requires a descriptive User-Agent with contact info for its API.
# See https://www.sec.gov/os/webmaster-faq#developers
FA_SEC_USER_AGENT=filings-assistant/0.1 (contact: you@example.com)

# --- Retrieval / chunking --------------------------------------------------
FA_CHUNK_SIZE_TOKENS=800
FA_CHUNK_OVERLAP_TOKENS=120
FA_TOP_K=6
# Shortlist size the reranker re-scores (Stage 2 of the ranking funnel).
FA_RERANK_CANDIDATES=50

# --- Multi-tenancy ---------------------------------------------------------
# bridge = shared OpenSearch cluster, index-per-tenant (default, recommended)
# silo   = separate infra per tenant (handled at deploy time)
FA_TENANCY_MODEL=bridge
# Fallback tenant for local/dev. Production resolves tenant from the auth token.
FA_DEFAULT_TENANT_ID=default

# --- Reranking (SageMaker cross-encoder) -----------------------------------
FA_ENABLE_RERANKING=true
# In aws mode, set to your SageMaker endpoint name to use the hosted reranker.
# Empty => local cross-encoder fallback.
FA_SAGEMAKER_RERANKER_ENDPOINT=
